#ifndef __action_msgs__msg__GoalStatus__idl
#define __action_msgs__msg__GoalStatus__idl

#include "action_msgs/msg/GoalInfo.idl"

module action_msgs {
  module msg {
    module GoalStatus_Constants {
      const octet STATUS_UNKNOWN = 0;
      const octet STATUS_ACCEPTED = 1;
      const octet STATUS_EXECUTING = 2;
      const octet STATUS_CANCELING = 3;
      const octet STATUS_SUCCEEDED = 4;
      const octet STATUS_CANCELED = 5;
      const octet STATUS_ABORTED = 6;
    };
    struct GoalStatus {
      action_msgs::msg::GoalInfo goal_info;
      octet status;
    };
  };
};


#endif // __action_msgs__msg__GoalStatus__idl
