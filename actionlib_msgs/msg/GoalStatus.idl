#ifndef __actionlib_msgs__msg__GoalStatus__idl
#define __actionlib_msgs__msg__GoalStatus__idl

#include "actionlib_msgs/msg/GoalID.idl"

module actionlib_msgs {
  module msg {
    module GoalStatus_Constants {
      const octet PENDING = 0;
      const octet ACTIVE = 1;
      const octet PREEMPTED = 2;
      const octet SUCCEEDED = 3;
      const octet ABORTED = 4;
      const octet REJECTED = 5;
      const octet PREEMPTING = 6;
      const octet RECALLING = 7;
      const octet RECALLED = 8;
      const octet LOST = 9;
    };
    @appendable struct GoalStatus {
      actionlib_msgs::msg::GoalID goal_id;
      octet status;
      string text;
    };
  };
};


#endif // __actionlib_msgs__msg__GoalStatus__idl
