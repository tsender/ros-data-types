#ifndef __visualization_msgs__msg__InteractiveMarkerFeedback__idl
#define __visualization_msgs__msg__InteractiveMarkerFeedback__idl

#include "geometry_msgs/msg/Point.idl"
#include "std_msgs/msg/Header.idl"
#include "geometry_msgs/msg/Pose.idl"

module visualization_msgs {
  module msg {
      module InteractiveMarkerFeedback_Constants {
        const octet KEEP_ALIVE = 0;
        const octet POSE_UPDATE = 1;
        const octet MENU_SELECT = 2;
        const octet BUTTON_CLICK = 3;
        const octet MOUSE_DOWN = 4;
        const octet MOUSE_UP = 5;
      };
      struct InteractiveMarkerFeedback {
        std_msgs::msg::Header header;
        string client_id;
        string marker_name;
        string control_name;
        octet event_type;
        geometry_msgs::msg::Pose pose;
        uint32 menu_entry_id;
        geometry_msgs::msg::Point mouse_point;
        boolean mouse_point_valid;
      };
  };
};


#endif // __visualization_msgs__msg__InteractiveMarkerFeedback__idl
